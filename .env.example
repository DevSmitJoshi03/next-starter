# Copy this file to .env.local and fill in real values.
# All variables here are validated against the schema in src/env.ts —
# the build fails immediately if a required value is missing or malformed.

# Server-only variables (never exposed to the browser):
# DATABASE_URL=

# Variables prefixed with NEXT_PUBLIC_ are validated but inlined into the
# client bundle at build time, so never put secrets here:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL for the axios client (src/lib/axios.ts). Leave unset to make
# requests relative to the current origin (e.g. same-app /api routes).
# NEXT_PUBLIC_API_URL=https://api.example.com

# Set to "true" to skip env validation (e.g. in Docker build stages that
# don't have runtime secrets yet):
# SKIP_ENV_VALIDATION=true
